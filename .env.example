# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.
#
# All variables here are read by src/shared/config.py via pydantic-settings.
# If a variable has a default shown, that default is used when the variable
# is absent; variables without a default MUST be set before running the pipeline.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for: text-embedding-3-small, gpt-4o-mini generation, LLM-judge, RAGAS
OPENAI_API_KEY=sk-...

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for: Claude 3 Haiku/Sonnet generation backend
ANTHROPIC_API_KEY=sk-ant-...

# ── Cohere ────────────────────────────────────────────────────────────────────
# Required for: rerank-english-v3.0 reranking API
COHERE_API_KEY=...

# ── SEC EDGAR ─────────────────────────────────────────────────────────────────
# The SEC requires a User-Agent identifying who is making requests.
# Format: "CompanyOrPersonName email@domain.com"
# See: https://www.sec.gov/developer
EDGAR_USER_AGENT="SEC-RAG-Research contact@example.com"

# ── OpenSearch ────────────────────────────────────────────────────────────────
# Override these if OpenSearch is not running on localhost (e.g. in Docker).
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
# Leave blank if security is disabled (local dev default).
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional: set a Qdrant API key if your instance requires one (cloud deployments).
QDRANT_API_KEY=

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL for the local Ollama REST API server.
OLLAMA_BASE_URL=http://localhost:11434

# ── Redis (optional — semantic query cache) ───────────────────────────────────
# Only needed if profiling.exact_match_cache is backed by Redis in production.
REDIS_URL=redis://localhost:6379/0

# ── Pipeline config override ──────────────────────────────────────────────────
# Path to the YAML config file.  Defaults to configs/config.yaml.
CONFIG_PATH=configs/config.yaml
