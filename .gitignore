# .gitignore — SEC EDGAR Financial RAG Pipeline

# ── Python runtime artefacts ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment and secrets ───────────────────────────────────────────────────
.env
*.env.local
*.env.production
# Never commit real API keys or credentials.

# ── Data artefacts (large binary / generated files) ───────────────────────────
# Keep the directory skeleton (.gitkeep) but not the actual data files.
data/raw/**/*.html
data/raw/**/*.htm
data/raw/manifest.csv
data/parsed/**/*.json
data/chunks/**/*.jsonl
data/indexes/
data/profiles/**/*.jsonl
data/results/**/*.csv
data/results/**/*.md
data/eval/eval_set.jsonl
# Qdrant local storage (if not using Docker volume)
qdrant_storage/

# ── Model weights (never commit these — download at runtime) ──────────────────
*.bin
*.pt
*.pth
*.safetensors
*.gguf
# HuggingFace cache (typically in ~/.cache/huggingface — listed here for safety)
.cache/huggingface/

# ── Jupyter notebooks — strip outputs before committing ───────────────────────
# Outputs are stripped by pre-commit (nbstripout hook).
# The .ipynb files themselves ARE committed; only outputs are excluded by hook.
.ipynb_checkpoints/

# ── IDE and editor files ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ── Test and coverage artefacts ───────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Docker ───────────────────────────────────────────────────────────────────
# Docker volumes managed externally — not committed.
docker/volumes/

# ── Profiling output ─────────────────────────────────────────────────────────
*.prof
*.lprof

# ── Pinned lock file (generated, not hand-edited) ─────────────────────────────
# Commit requirements.lock to CI but exclude it from regular dev commits
# if your team prefers flexible installs.
# requirements.lock
